{%- comment -%}
  MyStorefront Postback — Click ID Capture (theme app embed)

  This block delegates capture behaviour to the backend-served capture.js so
  there is ONE source of truth for cookie name, cookie days, and URL
  parameter names. Merchant settings configured in the embedded app
  (param_names / cookie_name / cookie_days) are honoured here because this
  block just loads the same script the pixel-script route serves.

  A self-contained inline fallback runs only if the external script fails to
  load (e.g. the app backend is unreachable). The fallback mirrors the main
  script's three-layer attribution:
    1. Hidden input on add-to-cart forms (line-item property
       "_MyStorefront click_id" — underscore hides it from cart/checkout)
    2. Cart attribute via /cart/update.js (order note_attribute
       "MyStorefront click_id")
    3. Cookie + localStorage persistence (URL > cookie > localStorage)
{%- endcomment -%}

<script>
/* Hide MyStorefront item notes on older themes straight away, without
   waiting for capture.js to load. Display only, tracking is unaffected. */
(function () {
  var RE = /_*MyStorefront (?:click_id|Creator Referral|creator)\s*:?\s*[A-Za-z0-9._-]*/g;
  function onlyOurs(el) {
    return (el.textContent || '').replace(RE, '').replace(/[\s:]/g, '') === '';
  }
  function hide(scope) {
    try {
      if (!scope || typeof document.createTreeWalker !== 'function') return;
      var w = document.createTreeWalker(scope, NodeFilter.SHOW_TEXT, null);
      var hits = [];
      var n;
      while ((n = w.nextNode())) {
        if (n.nodeValue && n.nodeValue.indexOf('MyStorefront ') !== -1) hits.push(n);
      }
      for (var i = 0; i < hits.length; i++) {
        var el = hits[i].parentElement;
        if (!el || (el.closest && el.closest('script,style,noscript,textarea'))) continue;
        var target = null;
        var cur = el;
        for (var d = 0; d < 6 && cur && cur !== document.body; d++) {
          if (onlyOurs(cur)) { target = cur; cur = cur.parentElement; } else break;
        }
        if (target) target.style.display = 'none';
      }
    } catch (e) {}
  }
  hide(document.body);
  if (typeof MutationObserver === 'undefined' || !document.body) return;
  new MutationObserver(function (mutations) {
    for (var i = 0; i < mutations.length; i++) {
      var m = mutations[i];
      if (m.type === 'characterData') {
        if (m.target && m.target.parentElement) hide(m.target.parentElement);
        continue;
      }
      var added = m.addedNodes;
      for (var j = 0; j < added.length; j++) {
        var node = added[j];
        if (node.nodeType === 1) hide(node);
        else if (node.nodeType === 3 && node.parentElement) hide(node.parentElement);
      }
    }
  }).observe(document.body, { childList: true, subtree: true, characterData: true });
})();
</script>

<script>
(function () {
  var APP_URL = {{ block.settings.app_url | default: 'https://mystorefront-postback.onrender.com' | json }};
  var SHOP = {{ shop.permanent_domain | json }};

  // 1. Try the merchant-configured capture script (single source of truth).
  var s = document.createElement('script');
  s.async = true;
  s.src = APP_URL + '/pixel/' + encodeURIComponent(SHOP) + '/capture.js';
  s.onerror = runFallback;
  (document.head || document.documentElement).appendChild(s);

  // 2. Fallback — only runs if the external script fails to load.
  //    Uses defaults that match the schema defaults in pixel-script.js.
  function runFallback() {
    try {
      var COOKIE_NAME = 'click_id';
      var COOKIE_DAYS = 30;
      var STORAGE_TS_KEY = 'mystorefront_click_id_ts';
      // Underscore prefix hides the line item property from cart/checkout/
      // customer emails. Admin still shows "_MyStorefront click_id" against
      // each line item. Must match the value used in pixel-script.js so the
      // backend extractor finds it.
      var LINE_ITEM_PROP = '_MyStorefront click_id';
      var CART_ATTR_NAME = 'MyStorefront click_id';
      var CART_WRITE_FLAG = 'mystorefront_cart_written_private_v2';

      function getUrlParam() {
        try {
          return new URLSearchParams(window.location.search).get('click_id');
        } catch(e) { return null; }
      }

      function setCookie(value, days) {
        var expires = new Date(Date.now() + days * 864e5).toUTCString();
        var secure = location.protocol === 'https:' ? '; Secure' : '';
        document.cookie =
          COOKIE_NAME + '=' + encodeURIComponent(value) +
          '; expires=' + expires +
          '; path=/' +
          '; SameSite=Lax' +
          secure;
      }

      function getCookie() {
        var match = document.cookie.match(/(^|; )click_id=([^;]*)/);
        return match ? decodeURIComponent(match[2]) : null;
      }

      function setLocal(value, ts) {
        try { window.localStorage.setItem(COOKIE_NAME, value); window.localStorage.setItem(STORAGE_TS_KEY, String(ts)); } catch(e) {}
      }

      function getLocal() {
        try { return window.localStorage.getItem(COOKIE_NAME); } catch(e) { return null; }
      }

      function injectInto(form, clickId) {
        var sel = 'input[name="properties[' + LINE_ITEM_PROP + ']"]';
        var existing = form.querySelector(sel);
        if (existing) { existing.value = clickId; return; }
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'properties[' + LINE_ITEM_PROP + ']';
        input.value = clickId;
        form.appendChild(input);
      }

      function injectIntoAllForms(clickId) {
        try {
          var forms = document.querySelectorAll('form[action*="/cart/add"], form[action*="/cart/update"]');
          for (var i = 0; i < forms.length; i++) injectInto(forms[i], clickId);
        } catch(e) {}
      }

      function observeForNewForms(clickId) {
        if (typeof MutationObserver === 'undefined' || !document.body) return;
        try {
          var observer = new MutationObserver(function(mutations) {
            for (var i = 0; i < mutations.length; i++) {
              var added = mutations[i].addedNodes;
              for (var j = 0; j < added.length; j++) {
                var node = added[j];
                if (!node || node.nodeType !== 1) continue;
                if (node.matches && (node.matches('form[action*="/cart/add"]') || node.matches('form[action*="/cart/update"]'))) {
                  injectInto(node, clickId);
                }
                if (node.querySelectorAll) {
                  var inner = node.querySelectorAll('form[action*="/cart/add"], form[action*="/cart/update"]');
                  for (var k = 0; k < inner.length; k++) injectInto(inner[k], clickId);
                }
              }
            }
          });
          observer.observe(document.body, { childList: true, subtree: true });
        } catch(e) {}
      }

      function writeToCart(clickId) {
        try {
          var ss = null;
          try { ss = window.sessionStorage; } catch (e) {}
          // Write the cart attribute at most once per session.
          if (ss) {
            try { if (ss.getItem(CART_WRITE_FLAG) === clickId) return; } catch (e) {}
          }
          var attrs = {};
          attrs[CART_ATTR_NAME] = clickId;
          attrs['__MyStorefront click_id'] = '';
          attrs['__MyStorefront Creator Referral'] = '';
          fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attributes: attrs })
          }).catch(function() {});
          if (ss) {
            try { ss.setItem(CART_WRITE_FLAG, clickId); } catch (e) {}
          }
        } catch(e) {}
      }

      var urlId = getUrlParam();
      var ts = urlId ? Date.now() : Number((function() {
        try { return window.localStorage.getItem(STORAGE_TS_KEY); } catch(e) { return null; }
      })());
      var clickId = urlId || getCookie() || getLocal();
      if (!clickId || !Number.isFinite(ts) || ts <= 0 || ts > Date.now() + 60000 || Date.now() - ts >= COOKIE_DAYS * 864e5) return;
      setCookie(clickId, Math.max(0, COOKIE_DAYS - (Date.now() - ts) / 864e5));
      setLocal(clickId, ts);
      injectIntoAllForms(clickId);
      observeForNewForms(clickId);
      writeToCart(clickId);
    } catch (e) {}
  }
})();
</script>

{% schema %}
{
  "name": "Click ID Capture",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App backend URL",
      "default": "https://mystorefront-postback.onrender.com",
      "info": "Leave as the default unless your MyStorefront Postback backend is hosted on a custom domain. The capture script is loaded from this host."
    }
  ]
}
{% endschema %}
